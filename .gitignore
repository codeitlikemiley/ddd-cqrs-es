# Generated by Cargo
# will have compiled files and executables
target/
node_modules/
.spin/

# This workspace publishes the `ddd` executable, and CI/release commands use
# `--locked`; keep the root lockfile reproducible even though other lock files
# remain ignored below.

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds
*.pdb

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS specific
.DS_Store
Thumbs.db
*.lock
!/Cargo.lock

# Snapshot written by a redis-server started from the repo root for live tests
/dump.rdb

# Local UI audit dumps (not product assets)
examples/fullstack-app/.audit-shots/

# Per-project secrets persisted by the fullstack Makefile
.auth-root-key
.auth-outbox-key

# Accidental duplicate of src/app.rs at template root (source of truth is src/)
crates/ddd-cli/templates/fullstack/app.rs
